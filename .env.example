# Settings of the Supabase samples (the folders whose names end with -supabase).
#
# 1. Copy this file and name the copy  .env   (the file .env is never put into git).
# 2. Fill in the values of YOUR Supabase project. Both are shown in the dashboard of
#    the project: the button Connect, or Settings > API Keys.

# the address of the project
SUPABASE_URL=https://your-project.supabase.co

# The SECRET key of the project (it starts with sb_secret_). The secret key gives full
# access to the data, so it may be used only in programs that run on a server - like the
# Python programs of this course. Never put it into a web page or into source code.
SUPABASE_SECRET_KEY=sb_secret_...
